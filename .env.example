# NGP VAN API Configuration
# Official API Documentation: https://docs.ngpvan.com/reference/overview

# Application Name: The identifier registered with NGP VAN for your app or key
# (e.g. your_campaign_product, MyVolunteersTool, IN.013.mobilize)
app_name=your_application_name_here

# API Key: The key provided by your campaign/party VAN Administrator
van_api_key=00000000-0000-0000-0000-000000000000

# Database Mode:
# 0 = My Voters (voter file database; use this for general voter outreach/canvassing)
# 1 = My Campaign (committee database; use for donors, volunteers, event attendees)
db_mode=0

# Base URL (default is US production)
base_url=https://api.securevan.com/v4
